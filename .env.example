# Copy to .env.local and add your key. Without a key the chat runs on a scripted mock that plays the
# README demo (no network), and the rest of the app works as usual.
OPENAI_API_KEY=
# Optional: the model the agent runs on (default openai/gpt-5.4-mini). Use one your key's project can reach.
# COPILOT_MODEL=openai/gpt-5.4
# Or "mock" to run the scripted demo model even with a key set: rehearsals, or a fallback if the network fails.
# COPILOT_MODEL=mock
# The CopilotKit runtime sends usage telemetry by default (including error messages from failed runs).
# Uncomment to turn it off. DO_NOT_TRACK=1 works too.
# COPILOTKIT_TELEMETRY_DISABLED=true

# Optional: CopilotKit Intelligence, so real conversations and approval decisions reach Automatic
# Learning (README "Connect to CopilotKit Intelligence"). Off unless BOTH lines below are set; the
# stage demo runs with it off. Never commit a real key.
# CPK_INTELLIGENCE_ENABLED=true
# CPK_INTELLIGENCE_API_KEY=your-intelligence-project-key
# The Learning Space for threads and Trajectories (default vendor-contract-review):
# CPK_INTELLIGENCE_LEARNING_CONTAINER_ID=vendor-contract-review

# Deploying (README "Deploy it"). A production build (`npm start`, `npm run start:public`, any host) runs
# the scripted mock even when OPENAI_API_KEY is set: /api/copilotkit has no auth, so anyone who can reach
# it could run the agent on your key. Set this only when your own auth sits in front of the app.
# ALLOW_REAL_MODEL=true
# Set by the host on a deploy: `npm run start:public` listens on 0.0.0.0 and on $PORT (default 3000).
# PORT=3000
